        {
          "id": "55ff51ca-95a0-4d6c-a989-9bcf7db11c84",
          "name": "Execute a SQL statement over HTTP.",
          "request": {
            "name": "Execute a SQL statement over HTTP.",
            "description": {
              "content": "Executes an arbitrary SQL statement against the cluster. The SQL is sent as the raw request body (text/plain). This single endpoint covers all DDL and DML - SELECT, INSERT, CREATE TABLE (including VECTOR INDEX definitions), ALTER, and DROP - exactly as the ClickHouse HTTP interface behaves. Vector search is performed by issuing a SELECT that orders rows by the distance() function. Results may be requested in formats such as JSON, JSONEachRow, CSV, or TabSeparated via the default_format setting or a FORMAT clause.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "SQL statement, when supplied as a query-string parameter instead of the request body. Body and query parameter may be combined (e.g. DDL in query, data in body for INSERT)."
                },
                {
                  "disabled": false,
                  "key": "database",
                  "value": "default",
                  "description": "Default database for the statement."
                },
                {
                  "disabled": false,
                  "key": "default_format",
                  "value": "<string>",
                  "description": "Output format when the SQL does not include a FORMAT clause (e.g. JSON, JSONEachRow, CSV, TabSeparated)."
                }
              ],
              "variable": [
                {
                  "description": "Cluster host from the MyScale Cloud console Connection Details (MYSCALE_CLUSTER_URL).",
                  "type": "any",
                  "value": "{{clusterHost}}",
                  "key": "clusterHost"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "<string>"
            }
          },
          "response": [
            {
              "id": "2180a8ff-4ed9-442d-ba9c-0a0bf771efa6",
              "name": "Statement executed successfully. The body contains the result set in the requested format (empty for statements that return no rows).",
              "originalRequest": {
                "url": {
                  "path": [
                    ""
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "query",
                      "value": "<string>"
                    },
                    {
                      "key": "database",
                      "value": "default"
                    },
                    {
                      "key": "default_format",
                      "value": "JSON"
                    }
                  ],
                  "variable": [
                    {
                      "description": "Cluster host from the MyScale Cloud console Connection Details (MYSCALE_CLUSTER_URL).",
                      "type": "any",
                      "value": "{{clusterHost}}",
                      "key": "clusterHost"
                    }
                  ]
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "CREATE TABLE IF NOT EXISTS default.articles\n(\n    id UInt64,\n    title String,\n    content_vector Array(Float32),\n    CONSTRAINT cons_vec_len CHECK length(content_vector) = 768,\n    VECTOR INDEX article_idx content_vector TYPE HNSWFLAT('metric_type=Cosine')\n)\nENGINE = MergeTree ORDER BY id\n"
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"meta\": [\n    {\n      \"name\": \"string\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"string\",\n      \"type\": \"string\"\n    }\n  ],\n  \"data\": [\n    {\n      \"key_0\": true,\n      \"key_1\": 7306,\n      \"key_2\": true\n    },\n    {\n      \"key_0\": 5572,\n      \"key_1\": false,\n      \"key_2\": 6695\n    }\n  ],\n  \"rows\": 3348,\n  \"statistics\": {\n    \"elapsed\": 5675.936700070823,\n    \"rows_read\": 7868,\n    \"bytes_read\": 6045\n  }\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
